# Prism API base URL (required — no mock fallback).
# Only VITE_* variables belong in the frontend. They are bundled into the browser
# and must be treated as public. Do not add GEMINI_API_KEY, Google credentials,
# DATABASE_URL, JWT_SECRET, or any other backend secret here.

# Local / `npm run dev` — copy this file to .env
VITE_API_BASE_URL=http://127.0.0.1:8002/api/v1

# Local uvicorn on port 8000:
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Production builds use .env.production (https://api.prism.com/api/v1).
#
# Setup: copy to .env, then npm run dev → http://localhost:5174
# Guide: ../README.md
